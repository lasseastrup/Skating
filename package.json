{
  "name": "coping",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Coping - a mobile-first 3D skateboarding game in Three.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",

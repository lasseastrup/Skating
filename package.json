    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright-core": "^1.63.0",
    "typescript": "5.9",
    "vite": "^8.2.2"
  }
}
